<!DOCTYPE html>
<html lang="en">
    <head>
        <title>Sign In</title>
        {% include 'partials/_head.html.twig' %}
    </head>
    <body>
        <!-- Top Navitation Bar-->
        {% include 'partials/_navbar.html.twig' %}

        <!-- Sign in form -->
        <div class="container mt-4">
            <div class="row justify-content-center">
                <div class="col-11 col-lg-7 card">
                    <p class="fs-2 text-center mt-2">Authentication</p>
                    <form class="mb-4 mx-2" action=" {{ path('login') }} " method="post">
                        <div class="mb-3">
                            <label for="email" class="form-label">Email address</label>
                            <input type="email" class="form-control" id="_username" name="_username" aria-describedby="emailHelp" value="{{ last_username }}" required>
                            <div id="emailHelp" class="form-text">We'll never share your email with anyone else.</div>
                        </div>
                        <div class="mb-2">
                            <label for="password" class="form-label">Password</label>
                            <input type="password" class="form-control" id="_password" name="_password" required>
                        </div>
                        <!-- Error Message -->
                        {% if error %}
                            <div class="mb-2">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                        {% endif %}
                        <input type="hidden" name="_target_path" value="/dashboard">
                        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
                        <button type="submit" class="btn btn-primary">Submit</button>
                        <a class="ms-2 btn btn-secondary" href=" {{ path('app_register') }} " role="button">Register</a>
                    </form>
                </div>
            </div>
        </div>

        <!-- Javascript -->
        <script src="{{ asset('bootstrap/js/bootstrap.bundle.min.js') }}"></script>
    </body>
</html>
