                    <a href="https://www.youtube.com/watch?v=s-LEd0ffnnM&list=PLs69BFt3sil-9MgHSzrXpefUgKYh6Amjk&pp=gAQBiAQBsAgC"><img src=" {{ asset('images/youtube.png') }} " class="card-img-top" alt="youtube"></a>
