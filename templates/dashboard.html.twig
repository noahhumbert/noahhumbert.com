<!DOCTYPE html>
<html lang="en">
    <head>
        <title>Dashboard</title>
        {% include 'partials/_head.html.twig' %}
    </head>
    <body>
        <!-- Navbar -->
        {% include 'partials/_navbar.html.twig' %}

        {% if app.user and app.user.isVerified %}
            <h1>Verified</h1>
        {% else %}
            <a class="btn btn-primary" href="{{ path('send_verification') }}">Verify Email</a>
        {% endif %}

        <!-- Javascript -->
        <script src="{{ asset('bootstrap/js/bootstrap.bundle.min.js') }}"></script>
    </body>
</html>