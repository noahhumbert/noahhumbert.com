<!DOCTYPE html>
<html lang="en">
    <head>
        <title>Noah Humbert</title>
        {% include 'partials/_head.html.twig' %}
    </head>
    <body>
        <!-- Top Navitation Bar-->
        {% include 'partials/_navbar.html.twig' %}

        <!-- Top Banner -->
        <div class="container mt-2 mb-5 text-center">
            <div class="row">
                <div class="col-12">
                    <p class="fs-1 my-0">Noah Humbert</p>
                    <p class="fs-5 my-0">I design simple, reliable systems that solve real world business problems</p>
                </div>
            </div>
            <div class="row mt-3 justify-content-center">
                <div class="col-lg-2 col-6 d-grid gap-2">
                    <a class="btn btn-primary" href=" {{ path('business-card') }} ">Contact Me</a>
                </div>
                <div class="col-lg-2 col-6 d-grid gap-2">
                    <a class="btn btn-secondary" href="https://github.com/noahhumbert">Portfolio</a>
                </div>
            </div>
        </div>

        <!-- About Me Portion -->
        <div class="container my-5">
            <div class="row justify-content-center mb-2">
                <div class="col-12">
                    <div class="card" style="max-width: auto;">
                        <div class="row g-0">
                            <div class="col-md-4">
                                <img src=" {{ asset('images/noah.jpg') }} " class="card-img-top" alt="Noah">
                            </div>
                            <div class="col-md-8">
                                <div class="card-body">
                                    <h5 class="fs-2 mb-4">About me</h5>
                                    <p class="fs-6">
                                        I have loved technology since I can rememeber. From coding games in Scratch in elementary school to working on
                                        an IT support desk at 16 to now today being very skilled in multiple languages and having a high knolwedge of IT
                                        infrastructure as well as best practices while developing applications. I skipped out on going to college to pursue
                                        my passion right away instead of having to wait for 4 years in school. I also love playing wiffleball and basketball
                                        in my free time along with cooking!
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Solutions -->


        <!-- What I do Portion -->
        <div class="container my-5">
            <div class="row">
                <p class="fs-1 text-center">What I do</p>
            </div>
            <div class="row justify-content-center">
                <div class="card-group col-12">
                    <div class="card"> 
                        <h4 class="card-header text-center">
                            Workflow Automation & Internal Tools
                        </h4>
                        <div class="card-body">
                            <p class="card-text">
                                - Get Rid of Messy Excel Sheets<br>
                                - Data Entry Automation<br>
                                - Auto-generated Reports<br>
                                - Batch file processing<br>
                                - Data Congregations
                            </p>
                        </div>
                    </div>
                    <div class="card">
                        <h4 class="card-header text-center">
                            Internal System Integration & Congregation
                        </h4>
                        <div class="card-body">
                            <p class="card-text">
                                - Connect Invoicing into CRMs<br>
                                - Sync Databases<br>
                                - Migrate Data between Sources<br>
                                - Bridge Legacy Systems with Modern APIs
                            </p>
                        </div>
                    </div>
                    <div class="card">
                        <h4 class="card-header text-center">
                            Custom Web Applications & Websites
                        </h4>
                        <div class="card-body">
                            <p class="card-text">
                                - Internal Job Tracker<br>
                                - Inventory/Asset Management<br>
                                - Customer Portals<br>
                                - Booking/Scheduling Systems<br>
                                - Simple Dashboards<br>
                                - CRMs
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Closing CTA -->
        <div class="container my-5">
            <div class="row">
                <p class="fs-1 text-center">Contact Me</p>
            </div>
            <div class="row justify-content-center">
                <div class="col-12 text-center">
                    {% include 'partials/_business-card.html.twig' %}
                </div>
            </div>
        </div>

        <!-- Javascript -->
        <script src="{{ asset('bootstrap/js/bootstrap.bundle.min.js') }}"></script>
    </body>
</html>